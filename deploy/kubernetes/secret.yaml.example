# Template only — NOT applied by `kustomize build` (see kustomization.yaml).
# Prefer external-secret.yaml (External Secrets Operator). To use this file
# instead: copy it to a path OUTSIDE version control, fill in real values,
# and `kubectl apply -f` it before syncing the kustomization.
apiVersion: v1
kind: Secret
metadata:
  name: omnipotent-secrets
  namespace: omnipotent
  labels:
    app.kubernetes.io/name: omnipotent
type: Opaque
stringData:
  # Replace with actual values or use external secret management
  # Recommended: Use External Secrets Operator, Vault, or AWS Secrets Manager
  COPILOT_DATABASE_URL: "postgresql://user:password@postgres:5432/copilot"
  COPILOT_REDIS_URL: "redis://redis:6379/0"
  COPILOT_API_TOKEN: "change-me-in-production"
  # Encrypts per-tenant credentials at rest. Settings refuses to start when
  # COPILOT_MULTI_TENANT=true and COPILOT_ENV=production without it (see
  # configmap.yaml, which sets both), so this key is not optional here.
  COPILOT_SECRET_KEY: "change-me-in-production"
  # LLM Provider API Keys (set the one you use)
  ANTHROPIC_API_KEY: ""
  OPENAI_API_KEY: ""
  # Webhook secrets
  GITHUB_WEBHOOK_SECRET: ""
  GITLAB_WEBHOOK_SECRET: ""
  SLACK_BOT_TOKEN: ""
  PAGERDUTY_API_TOKEN: ""
