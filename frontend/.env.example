# Base URL of the DevOps Copilot FastAPI backend.
VITE_API_URL=http://localhost:8000
# Bearer token — only needed when the backend sets COPILOT_API_TOKEN.
VITE_API_TOKEN=

# Supabase (optional - enables auth and persistent storage)
# Get these from your Supabase project: Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Address for "contact us" links (pricing, billing support). Defaults to the maintainer's email.
VITE_CONTACT_EMAIL=

# EmailJS (for sending team invitations via email)
# Get these from your EmailJS dashboard: https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
